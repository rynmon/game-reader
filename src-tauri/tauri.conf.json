{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Reader",
  "version": "2.0.0",
  "identifier": "com.gamereader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Game Reader",
        "width": 820,
        "height": 640,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../assets/voices.json",
      "../assets/engine-runtime.json",
      "../assets/tesseract/**/*"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
